DATABASE_URL=postgresql://postgres:PASSWORD@db.maqrttlzwcnjipnjrdgh.supabase.co:5432/postgres
SUPABASE_URL=https://maqrttlzwcnjipnjrdgh.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
STORAGE_BUCKET=user-files

# AI (Mistral) — optional. Leave unset to run without AI; features degrade gracefully.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-large-latest

# Deployment / hardening
# Comma-separated allowed frontend origins, e.g. https://cloudbase.vercel.app
CORS_ORIGINS=
# In production (HTTPS, cross-site cookies): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
